# Copy this file to .env and change the values if needed.

# Port the backend runs on
PORT=5000

# Address of the React frontend (used for CORS)
CLIENT_URL=http://localhost:5173

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/campusloop

# Secret used to sign the session cookie (use any long random text)
SESSION_SECRET=change-this-secret
